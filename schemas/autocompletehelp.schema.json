{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoCompleteHelp — proyecto",
  "description": "Fuente de verdad del proyecto para AutoCompleteHelp: objetivo, stack, convenciones, arquitectura y plan. Se versiona junto al código.",
  "type": "object",
  "required": [
    "prompt"
  ],
  "properties": {
    "prompt": {
      "type": "string",
      "description": "Qué estás construyendo y cómo quieres que te ayude."
    },
    "leccion": {
      "type": "string",
      "description": "Lección sin IA de AutoCompleteHelp: el código de cada paso ya está escrito y no necesita modelo.",
      "enum": [
        "typescript-gastos",
        "python-descargas",
        "gsap-tarjetas",
        "shader-atardecer",
        "fundamentos-js",
        "logica-js",
        "matematicas-js",
        "diseno-js"
      ]
    },
    "perfil": {
      "type": "string",
      "description": "Perfil de stack curado. Lo fija «Elegir stack del proyecto»; define los archivos base y los comandos de «Crear estructura».",
      "enum": [
        "web-basica",
        "node-express",
        "python-fastapi",
        "react-vite",
        "django"
      ]
    },
    "stack": {
      "type": "object",
      "description": "Tecnologías del proyecto, con versión. Todas las sugerencias usan exactamente este stack.",
      "properties": {
        "resumen": {
          "type": "string",
          "description": "El stack en una frase, ej: \"Node.js + Express 5 + MongoDB\"."
        },
        "lenguaje": {
          "type": "string",
          "description": "Lenguaje y versión, ej: \"JavaScript (Node 22)\"."
        },
        "framework": {
          "type": "string",
          "description": "Framework y versión, ej: \"Express 5\"."
        },
        "datos": {
          "type": "string",
          "description": "Base de datos y librería, ej: \"MongoDB con Mongoose 8\"."
        },
        "tests": {
          "type": "string",
          "description": "Framework de tests, ej: \"node:test\"."
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "convenciones": {
      "type": "array",
      "description": "Reglas del proyecto que las sugerencias deben respetar.",
      "items": {
        "type": "string"
      }
    },
    "arquitectura": {
      "type": "object",
      "description": "Arquitectura del proyecto. La fija «Elegir arquitectura» (o «Elegir stack»); el plan y el código siguen su estructura y sus reglas. La decisión se explica en docs/ARQUITECTURA.md.",
      "required": [
        "estilo"
      ],
      "properties": {
        "estilo": {
          "type": "string",
          "enum": [
            "capas",
            "mvc",
            "modular",
            "hexagonal",
            "clean",
            "componentes",
            "microservicios",
            "serverless",
            "eventos"
          ]
        },
        "nombre": {
          "type": "string"
        },
        "razones": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "carpetas": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Estructura orientativa."
        },
        "reglas": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Reglas que el código respeta, sobre todo de dependencias entre partes."
        }
      }
    },
    "entorno": {
      "type": "object",
      "description": "Cómo se prepara, ejecuta y testea el proyecto. «Preparar el entorno» lo escribe en la terminal, sin ejecutarlo.",
      "properties": {
        "instalar": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "comando"
            ],
            "properties": {
              "comando": {
                "type": "string"
              },
              "windows": {
                "type": "string",
                "description": "Variante para Windows, si cambia."
              },
              "explicacion": {
                "type": "string",
                "description": "Qué hace y por qué."
              }
            }
          }
        },
        "ejecutar": {
          "type": "object",
          "required": [
            "comando"
          ],
          "properties": {
            "comando": {
              "type": "string"
            },
            "windows": {
              "type": "string",
              "description": "Variante para Windows, si cambia."
            },
            "explicacion": {
              "type": "string",
              "description": "Qué hace y por qué."
            }
          }
        },
        "testear": {
          "type": "object",
          "required": [
            "comando"
          ],
          "properties": {
            "comando": {
              "type": "string"
            },
            "windows": {
              "type": "string",
              "description": "Variante para Windows, si cambia."
            },
            "explicacion": {
              "type": "string",
              "description": "Qué hace y por qué."
            }
          }
        },
        "docker": {
          "type": "object",
          "properties": {
            "porQue": {
              "type": "string"
            },
            "comandos": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "comando"
                ],
                "properties": {
                  "comando": {
                    "type": "string"
                  },
                  "windows": {
                    "type": "string",
                    "description": "Variante para Windows, si cambia."
                  },
                  "explicacion": {
                    "type": "string",
                    "description": "Qué hace y por qué."
                  }
                }
              }
            }
          }
        }
      }
    },
    "aprender": {
      "type": "object",
      "description": "Proyecto creado con «Quiero aprender».",
      "required": [
        "tema"
      ],
      "properties": {
        "tema": {
          "type": "string"
        },
        "nivel": {
          "type": "string"
        },
        "objetivos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "plan": {
      "type": "array",
      "description": "Pasos ordenados para construir el proyecto. La guía «➜ Siguiente paso» apunta al primero sin hacer.",
      "items": {
        "type": "object",
        "required": [
          "paso"
        ],
        "properties": {
          "paso": {
            "type": "string",
            "description": "Qué construir."
          },
          "archivo": {
            "type": "string",
            "description": "Archivo donde se construye, relativo a la raíz."
          },
          "concepto": {
            "type": "string",
            "description": "Concepto que enseña este paso."
          },
          "hecho": {
            "type": "boolean",
            "description": "Marca el paso como terminado.",
            "default": false
          },
          "tipo": {
            "type": "string",
            "enum": [
              "teoria",
              "codigo",
              "test",
              "config",
              "docker",
              "comando",
              "ejercicio"
            ],
            "description": "Qué tipo de paso es."
          },
          "comando": {
            "type": "string",
            "description": "Pasos tipo comando: lo que se escribe en la terminal (nunca se ejecuta solo)."
          },
          "explicacion": {
            "type": "string"
          },
          "verificar": {
            "type": "string",
            "description": "Comando que comprueba el paso al terminarlo (ej: npm test)."
          }
        }
      }
    }
  }
}
